{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"Resume.pdf\" ] && cp \"Resume.pdf\" \"assets/resume.pdf\" && rm \"Resume.pdf\" || true",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
